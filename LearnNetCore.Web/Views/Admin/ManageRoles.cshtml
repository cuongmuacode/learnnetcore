@model EditUserRolesViewModel

<h2>Phân quyền cho @Model.UserName</h2>

<form asp-action="ManageRoles" method="post">
    <input type="hidden" asp-for="UserId" />

    <div class="form-group">
        @for (int i = 0; i < Model.Roles.Count; i++)
        {
            <div class="form-check">
                <input asp-for="Roles[@i].IsSelected" class="form-check-input" />
                <label class="form-check-label">@Model.Roles[i].RoleName</label>
                <input type="hidden" asp-for="Roles[@i].RoleName" />
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Cập nhật quyền</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
