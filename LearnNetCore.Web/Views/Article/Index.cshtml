@using LearnNetCore.Application.Models
@model ArticleViewModel

@{
    ViewData["Title"] = "Article List";
}

<h2>@ViewData["Title"]</h2>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Content</th>
            <th>Create on date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ArticleResponseModel article in Model.Articles)
        {
            <tr>
                <td>@article.Title</td>
                <td>@article.Content</td>
                <td>@article.CreatedOnDate.ToString("yyy-mm-dd")</td>
            </tr>
        }
    </tbody>
</table>

<div class="pagination">
    <ul class="pagination">
        @if (Model.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { currentPage = Model.CurrentPage - 1 })">Previous</a>
            </li>
        }

        @for (int i = 1; i <= 5; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { currentPage = i })">@i</a>
            </li>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { currentPage = Model.CurrentPage + 1 })">Next</a>
            </li>
        }
    </ul>
</div>
