@using LearnNetCore.Application.Models
@model ArticleViewModel

@{
    ViewData["Title"] = "Article List";
}


<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="FullTextSearch" class="form-control" placeholder="Tìm kiếm bài viết..." />
        <button class="btn btn-primary" type="submit">
            Tìm kiếm
        </button>
    </div>
</form>

<div class="row">
    @foreach (var article in Model.Articles)
    {
        <div class="card mb-2 h-100">
            <div class="row">
                <div class="col-auto">
                    <img src="https://picsum.photos/id/20/300/300" />
                </div>

                <div class="card-body col-8">
                    <h5 class="card-title">@article.Title</h5>
                    <p class="card-text">@(article?.Content ?? string.Empty)</p>
                    <p class="card-text">
                        <small class="text-muted">Created on: @article.CreatedOnDate?.ToString("yyyy-MM-dd")</small>
                    </p>
                </div>
            </div>
        </div>
    }
</div>
<a href="@Url.Action("Update", "Article")"
   class="btn btn-primary rounded-circle shadow position-fixed"
   style="bottom: 30px; right: 30px; width: 60px; height: 60px; z-index: 1000; display: flex; align-items: center; justify-content: center;">
    new
</a>

<div class="row justify-content-end">

    <div class="mt-4">
        <ul class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new { currentPage = Model.CurrentPage - 1 })">Previous</a>
                </li>
            }

            @for (int i = Model.CurrentPage; i <= Model.CurrentPage + 3; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { currentPage = i })">@i</a>
                </li>
            }

            @if (Model.CurrentPage >= 1)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new { currentPage = Model.CurrentPage + 1 })">Next</a>
                </li>
            }
        </ul>
    </div>
</div>
